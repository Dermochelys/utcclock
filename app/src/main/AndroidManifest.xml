<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Exact alarm permissions for precise clock widget updates -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />

    <uses-permission android:name="android.permission.USE_EXACT_ALARM"
        tools:ignore="ExactAlarmPolicy" />

    <!-- Custom permission to restrict internal broadcasts to this app only -->
    <permission
        android:name="com.dermochelys.utcclock.permission.INTERNAL_BROADCAST"
        android:protectionLevel="signature" />

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".Application"
        android:allowBackup="false"
        android:banner="@mipmap/ic_banner"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.UTCClock"
        tools:targetApi="36">

        <activity
            android:name=".Activity"
            android:exported="true"
            android:theme="@style/Theme.UTCClock">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.BroadcastReceiver"
            android:enabled="false"
            android:exported="true"
            android:permission="com.dermochelys.utcclock.permission.INTERNAL_BROADCAST">

            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>

            <intent-filter>
                <action android:name="com.dermochelys.utcclock.ACTION_APP_STARTED" />
            </intent-filter>

            <intent-filter>
                <action android:name="com.dermochelys.utcclock.ACTION_DISCLAIMER_STATE_CHANGED" />
            </intent-filter>

            <intent-filter>
                <action android:name="com.dermochelys.utcclock.ACTION_UPDATE_WIDGET" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".widget.GlanceAppWidgetReceiver"
            android:exported="true"
            android:permission="com.dermochelys.utcclock.permission.INTERNAL_BROADCAST">

            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/utc_clock_widget_info" />
        </receiver>
    </application>
</manifest>
